APP_NAME="SaaS Kit"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Provisioned automatically after migrations/database attachment when enabled.
SUPERADMIN_AUTO_PROVISION=false
SUPERADMIN_NAME="Super Administrator"
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=saas_kit
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# ─── Redis (queues, Reverb-adjacent state) ───
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Laravel Reverb (websocket server for Live Chat) ───
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# Local Reverb process (php artisan reverb:start)
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Laravel → Reverb publish (keep this on the local process, not public HTTPS)
REVERB_BACKEND_HOST=127.0.0.1
REVERB_BACKEND_PORT=8080
REVERB_BACKEND_SCHEME=http

# Browser clients (public hostname; usually 443 + https behind nginx)
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
# Optional overrides if client host differs from REVERB_HOST:
# REVERB_CLIENT_HOST=bigdemo.example.com
# REVERB_CLIENT_PORT=443
# REVERB_CLIENT_SCHEME=https

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Production nginx must proxy websockets, e.g.:
# location /app {
#     proxy_http_version 1.1;
#     proxy_set_header Host $http_host;
#     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#     proxy_set_header Upgrade $http_upgrade;
#     proxy_set_header Connection "Upgrade";
#     proxy_pass http://127.0.0.1:8080;
# }

# ─── Live Chat attachments ───
# Must be a PRIVATE disk. Files are served only through the download
# controllers, which re-check tenant ownership and the visitor token.
CHAT_ATTACHMENT_DISK=local
CHAT_ATTACHMENT_MAX_KB=10240

# ─── Live Chat AI assist (optional) ───
# "null" (default) leaves AI assist switched off entirely.
CHAT_AI_PROVIDER=null
CHAT_AI_MAX_TOKENS=8192
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
KIMI_API_KEY=
KIMI_MODEL=kimi-k3
MOONSHOT_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Stripe (Cashier) ───
STRIPE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ─── Cashier ───
CASHIER_CURRENCY=usd
CASHIER_LOGGER=stack

VITE_APP_NAME="${APP_NAME}"
