{
    "version": "0.0.1",
    "autoPort": false,
    "configurations": [
        {
            "name": "laravel",
            "runtimeExecutable": "php",
            "runtimeArgs": ["artisan", "serve", "--port=8002"],
            "port": 8002
        },
        {
            "name": "vite",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "dev"],
            "port": 5173
        },
        {
            "name": "reverb",
            "runtimeExecutable": "php",
            "runtimeArgs": ["artisan", "reverb:start", "--port=8081"],
            "port": 8081
        },
        {
            "name": "queue",
            "runtimeExecutable": "php",
            "runtimeArgs": ["artisan", "queue:work", "--queue=broadcast,default", "--tries=1"]
        }
    ]
}
